# INFERNUS - Supabase & Server Configuration
PORT=3000
# JWT_SECRET is the primary name; SECRET_KEY is the legacy fallback
JWT_SECRET=infernus_super_secret_key_change_in_production
SECRET_KEY=infernus_super_secret_key_change_in_production

# Supabase Credentials (from Supabase Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key
